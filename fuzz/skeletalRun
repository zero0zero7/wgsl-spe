#!/bin/bash
# Generate one shader, enumerate SKELETONS random skeletal variants of it, then
# recondition and run each variant (and the original) through wgslsmith. This
# multiplies the test surface per generated shader: a single seed yields the
# original plus N variants that swap in-scope variables into candidate usages.
#
# Pipeline (per seed):
#   wgslsmith gen              -> gen.wgsl
#   recondition + run gen.wgsl                 (the BASELINE)
#     - if the baseline fails, the seed is marked baseline-fail and we stop
#       here: a broken original makes every skeleton failure uninterpretable,
#       so enumeration (the expensive JVM step) is skipped.
#   printSkeletalPrograms      -> skeleton_000.wgsl ... (random, --limit N)
#   for each skeleton_*:
#       wgslsmith recondition  -> rc
#       wgslsmith run          rc
#
# Artifacts go to runs/<config>/<seed>/. On full success they are removed; any
# variant that fails (or fails to recondition), or a failing baseline, is kept
# alongside its log.
#
# The number of variants is SKELETONS (default 8), overridable from the
# environment: SKELETONS=20 fuzz/skeletalRun 42
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
source "$HERE/common.sh"

usage() {
    cat <<EOF
Usage: skeletalRun <seed> [config]

  seed    u64 seed for the generator
  config  name of a file in configs/ (default: "default")

Env:
  SKELETONS       number of random skeletons per shader (default: 8)
  PARSE_TIMEOUT   ms budget for the JVM tool to parse a shader (default: 60000;
                  raw wgslsmith output is often slow to parse)
  PRESERVE_FORMAT 1 (default) = splice replacements into the original text,
                  keeping wgslsmith's dialect; 0 = re-serialize via AstWriter
EOF
}

parse_seed_args "$@"
if [[ ! -x "$GRADLEW" ]]; then
    echo "ERROR: gradle wrapper not found/executable: $GRADLEW" >&2
    exit 1
fi

SEEDDIR=$(run_dir "$CONFIG" "$SEED")
GEN="$SEEDDIR/gen.wgsl"
SKEL_DIR="$SEEDDIR/skeletons"
LOG="$SEEDDIR/run.log"
: > "$LOG"

# Generate using wgslsmith.
do_gen "$GEN" "$LOG"
# Unlike the other runners, run.log persists for this seed (run_variant writes
# per-variant logs, never overwriting it), so strip gen's escape codes now.
strip_ansi_file "$LOG"

# Run one variant: recondition then execute. Returns 0 on pass. On failure,
# keeps the variant's .wgsl + .rc.wgsl and writes a per-variant <name>.log.
# Defined before the baseline run below so enumeration can be gated on it.
PASS=0
FAIL=0
FAIL_CATEGORY=""
FAIL_NAME=""

run_variant() {
    local src="$1"
    local name; name=$(basename "$src" .wgsl)
    local rc="$SEEDDIR/${name}.rc.wgsl"
    local vlog="$SEEDDIR/${name}.log"

    if ! "$WGSLSMITH" recondition "$src" "$rc" 2>"$vlog"; then
        strip_ansi_file "$vlog"
        echo "  $name: recondition FAIL"
        (( FAIL++ )) || true
        [[ -z "$FAIL_CATEGORY" ]] && { FAIL_CATEGORY="recondition-failed"; FAIL_NAME="$name"; }
        return 1
    fi

    local out status # declare local variables
    # CONFIGS is a space-separated list of backend IDs; each becomes its own -c
    # flag (wgslsmith's -c is repeatable). Empty => defaults.
    local run_args=(run --timeout "$TIMEOUT")
    for cfg in $CONFIGS; do run_args+=(-c "$cfg"); done
    out=$("$WGSLSMITH" "${run_args[@]}" "$rc" 2>&1)
    status=$?

    if [[ $status -eq 0 ]]; then
        echo "  $name: run OK"
        rm -f "$rc" "$vlog"
        (( PASS++ )) || true
        return 0
    else
        echo "$out" | strip_ansi > "$vlog"
        local cat; cat=$(categorize < "$vlog")
        echo "  $name: run FAIL ($cat)"
        (( FAIL++ )) || true
        if [[ -z "$FAIL_CATEGORY" ]]; then
            FAIL_CATEGORY="$cat"
            FAIL_NAME="$name"
        fi
        return 1
    fi
}

# Baseline gating: run the original (unmutated) shader first. If it already
# fails to recondition/run, every skeleton would just inherit that breakage and
# tell us nothing about the variable swaps -- so mark the seed baseline-fail and
# skip enumeration entirely (it's the expensive JVM step). gen.wgsl + its
# .rc.wgsl/.log are kept for triage (run_variant retains them on failure).
if ! run_variant "$GEN"; then
    echo "baseline FAILED (seed=$SEED, $FAIL_CATEGORY): skipping skeletons" >&2
    write_meta "$SEEDDIR" "$CONFIG" "$SEED" "baseline-fail" "${FAIL_CATEGORY}:gen"
    exit 1
fi

# Baseline passed -> enumerate random skeletons via the JVM tool.
# printSkeletalPrograms writes to <output-dir>/skeleton_NNN.wgsl.
rm -rf "$SKEL_DIR"
# With PRESERVE_FORMAT=1 (default), --preserve-format splices replacements into
# the original text instead of re-serializing via AstWriter, so the skeletons
# stay in wgslsmith's dialect and reconditioning/running them works (see
# fuzz/INTEGRATION_NOTES.md S6). Set PRESERVE_FORMAT=0 for the AstWriter path.
PRESERVE_FLAG=""
[[ "$PRESERVE_FORMAT" != "0" ]] && PRESERVE_FLAG="--preserve-format"
ENUM_OUT=$(cd "$REPO_ROOT" && "$GRADLEW" -q printSkeletalPrograms \
    --args="--shader $GEN --random --limit $SKELETONS --parse-timeout $PARSE_TIMEOUT $PRESERVE_FLAG --output-dir $SKEL_DIR" 2>&1)
if [[ $? -ne 0 ]]; then
    echo "ERROR: enumeration failed (seed=$SEED)" >&2
    echo "$ENUM_OUT" | strip_ansi >> "$LOG"
    write_meta "$SEEDDIR" "$CONFIG" "$SEED" "error" "enumerate-failed"
    exit 1
fi

# The skeletons to test (sorted for stable numbering). The original already ran
# above as the baseline, so it is not in this list.
mapfile -t SKELS < <(find "$SKEL_DIR" -name 'skeleton_*.wgsl' 2>/dev/null | sort)
echo "enumerated ${#SKELS[@]} skeleton(s) -> testing baseline + ${#SKELS[@]} skeleton(s)"

for v in "${SKELS[@]}"; do
    run_variant "$v"
done

echo "variants: $PASS passed, $FAIL failed"

if [[ $FAIL -eq 0 ]]; then
    write_meta "$SEEDDIR" "$CONFIG" "$SEED" "pass" "none"
    rm -rf "$SKEL_DIR"
    rm -f "$GEN" "$LOG"
    echo "PASS (seed=$SEED)"
else
    # Keep everything for triage: the original gen.wgsl, the enumeration tree
    # (failing skeletons live there), and each failing variant's .rc.wgsl/.log.
    # Passing variants already had their rc/log removed in run_variant.
    write_meta "$SEEDDIR" "$CONFIG" "$SEED" "fail" "${FAIL_CATEGORY}:${FAIL_NAME}"
    echo "FAILED (seed=$SEED, $FAIL_CATEGORY in $FAIL_NAME): artifacts in $SEEDDIR/" >&2
    exit 1
fi
