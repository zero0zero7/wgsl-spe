.env
.DS_Store
.idea/
bin/
build/
node_modules/
.gradle/

out/
# Disposable run artifacts, segregated per host (runs/<hostname>/...). Curated
# reproductions are kept under cases/ (tracked) instead.
runs/

# Filesystem-wide tool paths (copy from fuzz/common.local.sh.example). Per-host
# overrides live in fuzz/hosts/<hostname>.sh and ARE tracked -- see the
# "Per-machine setup" section of fuzz/README.md.
fuzz/common.local.sh

# Machine-specific run configs: only default.env (portable) is shipped. Other
# configs select machine-specific backends, so they're gitignored; they can
# still reference per-host CFG_* symbols from fuzz/hosts/<hostname>.sh.
fuzz/configs/*.env
!fuzz/configs/default.env

bs.wgsl

include/
gradle.properties
