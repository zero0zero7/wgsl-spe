default.profraw

out/
# Disposable run artifacts, segregated per host (runs/<hostname>/...). Curated
# reproductions are kept under cases/ (tracked) instead.
runs/

# Run configs are tracked: they select backends symbolically via per-host CFG_*
# symbols (with literal :- fallbacks), so they're portable across the fleet. The
# only machine-specific data -- the adapter IDs those CFG_* resolve to -- lives
# in fuzz/hosts/<hostname>.sh. See the "Configs" section of fuzz/README.md.

bs.wgsl

include/
gradle.properties
